+// Deterministic 1D value noise in [0, 1] (splitmix-style lattice hash +
+// smoothstep interpolation). Deterministic across runs so the same model
+// slices to identical gcode every time (unlike random_value above).
+static uint64_t fuzzy_hash(uint64_t x)
+{
+    x ^= x >> 30; x *= 0xbf58476d1ce4e5b9ULL;
+    x ^= x >> 27; x *= 0x94d049bb133111ebULL;
+    x ^= x >> 31; return x;
+}
+
+static double fuzzy_value_noise(double s, uint64_t seed)
+{
+    const int64_t i = (int64_t)std::floor(s);
+    const double  f = s - (double)i;
+    const double  u = f * f * (3.0 - 2.0 * f);
+    const double  a = (double)(fuzzy_hash((uint64_t)(i * 2 + 1) ^ (seed * 2 + 1)) >> 11)
+        * (1.0 / 9007199254740992.0);
+    const double  b = (double)(fuzzy_hash((uint64_t)(i * 2 + 3) ^ (seed * 2 + 1)) >> 11)
+        * (1.0 / 9007199254740992.0);
+    return a + (b - a) * u;
+}
+
+static double fuzzy_fbm(double s, int octaves, double persistence, uint64_t seed)
+{
+    if (octaves < 1) octaves = 1;
+    if (octaves > 8) octaves = 8;
+    if (persistence < 0.) persistence = 0.;
+    if (persistence > 1.) persistence = 1.;
+    double sum = 0., amp = 1., norm = 0., freq = 1.;
+    for (int o = 0; o < octaves; ++o) {
+        sum += amp * fuzzy_value_noise(s * freq, seed + (uint64_t)o * 7919ULL);
+        norm += amp;
+        amp *= persistence;
+        freq *= 2.0;
+    }
+    return norm > 0. ? sum / norm : 0.5;
+}
+
+static double fuzzy_offset(const FuzzySkinParams &params, double arclen)
+{
+    const double amp = params.thickness * (params.scale < 0. ? 0. : params.scale);
+    if (!params.fractal)
+        return random_value() * (amp * 2.) - amp;
+    const double pd = params.point_dist > 0. ? params.point_dist : 1.;
+    const double n  = fuzzy_fbm(arclen / pd, params.octaves, params.persistence, params.seed);
+    return (n * 2.0 - 1.0) * amp;
+}
