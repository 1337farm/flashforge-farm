namespace farm_iroh {
    // Bind (or re-bind with a persisted secret) an endpoint. data_dir is a
    // writable directory for the persistent blob store. All calls block on an
    // internal tokio runtime; nothing async crosses the FFI boundary.
    [Throws=FarmError]
    FarmEndpoint connect(bytes secret_key, string data_dir);

    // Parse/print helpers for endpoint ids (hex transport form).
    [Throws=FarmError]
    bytes endpoint_id_from_hex(string hex);
    [Throws=FarmError]
    string endpoint_id_to_hex(bytes endpoint_id);
};

[Error]
enum FarmError {
    "Internal",
    "InvalidInput",
    "NotFound",
    "Timeout",
};

interface FarmEndpoint {
    // Stable endpoint id bytes (32-byte ed25519 public key).
    bytes endpoint_id();

    // Persistable secret (32 bytes). Store in EncryptedSharedPreferences;
    // pass back to connect() to keep the same id across restarts.
    bytes secret_key_bytes();

    // Close cleanly, release sockets. Call on Android backgrounding.
    void shutdown();

    // ===== Blobs (content-addressed storage) =====
    // Store bytes, return blake3 hash (32 bytes).
    [Throws=FarmError]
    bytes blob_add(bytes data);

    // Load bytes by hash. Local store only (no network); use fetch_start
    // or sync_merge to pull remote blobs first.
    [Throws=FarmError]
    bytes blob_get(bytes hash);

    // Check local store (no network).
    [Throws=FarmError]
    boolean blob_has(bytes hash);

    // Drop local copy (peers unaffected).
    [Throws=FarmError]
    void blob_remove(bytes hash);

    // ===== Tickets (hash + provider address for sharing) =====
    // Shareable ticket string for a locally-stored blob.
    [Throws=FarmError]
    string ticket_for(bytes hash);

    // Inspect a ticket without fetching: returns "hash_hex:peer_hex".
    [Throws=FarmError]
    string ticket_info(string ticket);

    // ===== Models (metadata blob + file blobs + local search index) =====
    // Publish: stores files + metadata, indexes keywords, returns the
    // metadata-blob ticket (share this string; it IS the model ticket).
    [Throws=FarmError]
    string model_publish(string model_json, sequence<bytes> files);

    // Fetch runs in the background. Poll fetch_poll() for JSON status:
    // {"state":"metadata","model_json":..,"names":..,"hashes":..}
    // {"state":"progress","downloaded":n,"total":m}
    // {"state":"done","dir":..} | {"state":"error","msg":..}
    [Throws=FarmError]
    i64 fetch_start(string ticket, string dir);
    [Throws=FarmError]
    string fetch_poll(i64 handle);
    void fetch_stop(i64 handle);

    // ===== Distributed search (local index + epidemic sync, no hub) =====
    // Keyword lookup over locally-indexed models. Returns model-hash hexes.
    [Throws=FarmError]
    sequence<string> search_query(string keyword);

    // Metadata JSON for an indexed model hash (hex).
    [Throws=FarmError]
    string search_get_metadata(string model_hash);

    // Announcement ticket covering recent index entries. Share it; any peer
    // that merges it learns your models (epidemic propagation).
    [Throws=FarmError]
    string sync_announce();

    // Merge a peer announcement. Fetches + indexes unknown models (cap 100).
    // Returns JSON {"new_models": n, "model_tickets": [...]}.
    [Throws=FarmError]
    string sync_merge(string ticket);

    // Hex endpoint ids of peers we have downloaded from.
    sequence<string> known_peers();
};
