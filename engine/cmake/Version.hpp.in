#pragma once
// Generated 3.0 version header. Mirrors upstream
// src/slic3r-base/include/Slic3r/Version.hpp.in at the pinned 3.0-alpha;
// upstream's own CMake generates this during its build, but our standalone
// engine/app targets compile against the fetched headers directly, so we
// generate our own copy via configure_file. Values track the pin.
#define SLIC3R_APP_NAME "PrusaSlicer"
#define SLIC3R_APP_KEY "PrusaSlicer"
#define SLIC3R_VERSION "3.0.0-alpha11"
#define SLIC3R_BUILD_ID "PrusaSlicer-3.0.0-alpha11"

namespace Slic3r {
    constexpr const char* APP_NAME = SLIC3R_APP_NAME;
    constexpr const char* APP_KEY = SLIC3R_APP_KEY;
    constexpr const char* VERSION = SLIC3R_VERSION;
    constexpr const char* BUILD_ID = SLIC3R_BUILD_ID;
}
