# 0012: Android ships the engine untranslated — no boost::locale library.
# Boost.Locale cannot build on NDK API 23 (no iconv/ICU backend; patch 0002
# already dropped the component), but the 3.0 I18N TUs are live: the chain
# FileLoadingLogic -> _u8 -> boost::locale::translate().str() needs
# facet_id<message_format>::id, and Translation.cpp instantiates the
# generator. Under __ANDROID__, return the input strings (the farm app owns
# localization) and skip every generator/info-facet call. No behavior
# change on desktop builds.
diff --git a/src/slic3r-shared/src/Slic3r/Biz/I18N/I18N.cpp b/src/slic3r-shared/src/Slic3r/Biz/I18N/I18N.cpp
index 146d532..7a5d6cb 100644
--- a/src/slic3r-shared/src/Slic3r/Biz/I18N/I18N.cpp
+++ b/src/slic3r-shared/src/Slic3r/Biz/I18N/I18N.cpp
@@ -11,17 +11,31 @@ void set_ui_locale(std::locale/*&*/ new_locale)
 
 std::string _u8(const std::string& s) 
 { 
+#ifdef __ANDROID__
+    // Android: engine strings stay untranslated (the app owns i18n);
+    // avoids the boost::locale link dependency.
+    return s;
+#else
     return boost::locale::translate(s.c_str()).str(Slic3r::Biz::g_ui_locale);
+#endif
 }
 
 std::string _ctx_u8(const std::string& s, const std::string& ctx)
 { 
+#ifdef __ANDROID__
+    return s;
+#else
     return boost::locale::translate(ctx.c_str(), s.c_str()).str(Slic3r::Biz::g_ui_locale);
+#endif
 }
 
 std::string _L_PLURAL_u8(const std::string& single, const std::string& plural, int n)
 { 
+#ifdef __ANDROID__
+    return n == 1 ? single : plural;
+#else
     return boost::locale::translate(single.c_str(), plural.c_str(), n).str(Slic3r::Biz::g_ui_locale);
+#endif
 }
 
 }
\ No newline at end of file
diff --git a/src/slic3r-shared/src/Slic3r/Biz/I18N/Translation.cpp b/src/slic3r-shared/src/Slic3r/Biz/I18N/Translation.cpp
